# Optional server-side AI proxy. Never put provider keys in VITE_* variables.
# The proxy must return JSON { "text": "..." } and allow requests from the chosen host.
VITE_GOOGLE_SCRIPT_URL=
VITE_BASE_PATH=./

# Real lesson videos and optional WebVTT captions. Empty values use text instructions.
VITE_LESSON_1_VIDEO=
VITE_LESSON_1_CAPTIONS=
VITE_LESSON_2_VIDEO=
VITE_LESSON_2_CAPTIONS=
VITE_LESSON_3_VIDEO=
VITE_LESSON_3_CAPTIONS=
VITE_LESSON_4_VIDEO=
VITE_LESSON_4_CAPTIONS=
VITE_LESSON_5_VIDEO=
VITE_LESSON_5_CAPTIONS=
