# AI uses the authenticated progress API below and server-side configuration.
# Never put provider keys in VITE_* variables. Legacy AI/Google proxy URLs are ignored.
VITE_BASE_PATH=./

# Optional progress API. When configured, pupils sign in with a mentor-issued code.
# Example: https://<gateway>.apigw.yandexcloud.net/api (no tokens or cloud keys here).
VITE_PROGRESS_API_URL=

# Kinescope watch/embed links or direct MP4/WebM files. Empty values use text instructions.
# Kinescope captions are managed in Kinescope. *_CAPTIONS is for direct files only.
VITE_LESSON_1_VIDEO=
VITE_LESSON_1_CAPTIONS=
VITE_LESSON_2_VIDEO=
VITE_LESSON_2_CAPTIONS=
VITE_LESSON_3_VIDEO=
VITE_LESSON_3_CAPTIONS=
VITE_LESSON_4_VIDEO=
VITE_LESSON_4_CAPTIONS=
VITE_LESSON_5_VIDEO=
VITE_LESSON_5_CAPTIONS=
