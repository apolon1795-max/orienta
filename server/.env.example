# Server only. Never place these values in VITE_* variables.
ORIENTA_YDB_ENDPOINT=
# Native Table API is the pilot default. The endpoint above supplies the Russian database path.
ORIENTA_YDB_DRIVER=native
ORIENTA_YDB_TABLE=orienta_state
ORIENTA_ALLOWED_ORIGINS=https://apolon1795-max-orienta-c425.twc1.net

# Set true ONLY on the separate PRIVATE operator function (bootstrap.handler).
# Never make this function public or grant its invocation to the pupil API gateway.
ORIENTA_ADMIN_ENABLED=

# Local development / existing VDS only, outside the public web directory.
ORIENTA_DB_PATH=private/progress.sqlite
HOST=127.0.0.1
PORT=8787

# Admin CLI only: short-lived IAM token, not needed by the deployed function.
ORIENTA_IAM_TOKEN=

# ProxyAPI: server only, use a separate Orienta key with a one-time pilot budget.
# A key plus the explicit enable flag is required. No changes to billing/autotopup.
ORIENTA_AI_ENABLED=
ORIENTA_AI_API_KEY=
# The model and endpoint are fixed in server/ai.mjs.
# Hard limits: 100 reserved calls per key; 3 per pupil per UTC day.
# Failed/ambiguous calls count; identical successful profiles are cached in YDB.
